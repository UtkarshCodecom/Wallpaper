<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    card_view:cardCornerRadius="8dp"
    card_view:cardUseCompatPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/image_preview"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:adjustViewBounds="true"
            android:background="@color/skeleton"
            android:contentDescription="Wallpaper preview"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="9:20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- YouTube-style shimmering skeleton, shown until the image is ready -->
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@id/image_preview"
            app:layout_constraintEnd_toEndOf="@id/image_preview"
            app:layout_constraintStart_toStartOf="@id/image_preview"
            app:layout_constraintTop_toTopOf="@id/image_preview">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/skeleton" />
        </com.facebook.shimmer.ShimmerFrameLayout>

        <!-- selection indicator: thin accent bar at top when selected -->
        <View
            android:id="@+id/selection_bar"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:background="@color/accent"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Premium star indicator in top-right corner -->
        <ImageView
            android:id="@+id/premium_star"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_margin="6dp"
            android:contentDescription="Premium wallpaper"
            android:src="@drawable/ic_premium_star"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- YouTube play button (bottom-right) — shown only when the wallpaper has a yt link -->
        <ImageView
            android:id="@+id/yt_play_button"
            android:layout_width="34dp"
            android:layout_height="24dp"
            android:layout_margin="8dp"
            android:contentDescription="Play on YouTube"
            android:src="@drawable/ic_yt_play"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/image_preview"
            app:layout_constraintEnd_toEndOf="@id/image_preview" />

        <!-- Favorite heart (bottom-left) -->
        <ImageView
            android:id="@+id/fav_button"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_margin="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Favorite"
            android:padding="5dp"
            android:src="@drawable/ic_heart"
            app:layout_constraintBottom_toBottomOf="@id/image_preview"
            app:layout_constraintStart_toStartOf="@id/image_preview" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
