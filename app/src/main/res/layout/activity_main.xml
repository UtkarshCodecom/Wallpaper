<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- WallE header: title row + motto -->
    <LinearLayout
        android:id="@+id/walle_header"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:layout_gravity="top"
        android:background="@color/black"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/walle_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:shadowColor="@color/accent"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="9"
                android:text="WallE"
                android:textColor="@color/accent"
                android:textSize="22sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/grid_toggle"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Toggle grid columns"
                android:padding="5dp"
                android:src="@drawable/ic_grid_3"
                android:tint="@color/light_text" />

        </LinearLayout>

        <TextView
            android:id="@+id/walle_motto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:alpha="0.7"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.03"
            android:text="Make Your Screen Uniquely Yours"
            android:textColor="@color/light_text"
            android:textSize="12sp" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/top_nav_container"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="top"
        android:layout_marginTop="66dp"
        android:background="@color/black"
        android:elevation="6dp">

        <!-- soft yellow glow radiating from the bottom, behind the nav items -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="bottom"
            android:background="@drawable/nav_bottom_glow" />

        <com.walle.wallpaper.ui.TopNavBar
            android:id="@+id/top_navigation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />

        <!-- greyish baseline (shows under inactive tabs); accent indicator sits on top for active -->
        <View
            android:id="@+id/nav_line_base"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="bottom"
            android:background="@color/nav_line_inactive" />

        <View
            android:id="@+id/bottom_indicator"
            android:layout_width="90dp"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:layout_marginTop="-5dp"
            android:background="@color/accent" />

    </FrameLayout>

    <!-- Split container -->
    <FrameLayout
        android:id="@+id/split_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="130dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!--
            Main panel: pivot top-left, scales down toward left when settings opens.
            Width is set to MINI_SCALE * screenWidth in code so it doesn't
            intercept touches meant for the settings panel.
        -->
        <FrameLayout
            android:id="@+id/nav_host_fragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!--
            Settings panel: slides in from the right.
            Contains the fragment + a drag strip on its left edge.
        -->
        <FrameLayout
            android:id="@+id/settings_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black"
            android:clipChildren="false"
            android:elevation="4dp"
            android:visibility="gone">

            <!-- Settings fragment content fills the whole panel -->
            <FrameLayout
                android:id="@+id/settings_fragment_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Drag strip: ONLY on the left edge so content stays touchable -->
            <View
                android:id="@+id/settings_drag_strip"
                android:layout_width="32dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="@android:color/transparent"
                android:elevation="8dp" />

        </FrameLayout>

    </FrameLayout>

    <!-- Stickers coming soon container -->
    <FrameLayout
        android:id="@+id/stickers_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bgsticker"
        android:elevation="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/comingsoon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Coming Soon..."
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/stickers_top_nav_container"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="top"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_nav_oval_white"
            android:elevation="6dp">

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/stickers_top_navigation"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:paddingBottom="0dp"
                app:itemIconSize="0dp"
                app:itemPaddingBottom="18dp"
                app:itemRippleColor="#33000000"
                app:itemTextAppearanceActive="@style/TextAppearance.BottomNav.Active.Stickers"
                app:itemTextAppearanceInactive="@style/TextAppearance.BottomNav.Inactive.Stickers"
                app:itemTextColor="@color/nav_item_color_state_stickers"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/stickers_nav_menu" />

            <View
                android:id="@+id/stickers_bottom_indicator"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_gravity="bottom"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_dot_indicator" />

        </FrameLayout>
    </FrameLayout>


</androidx.coordinatorlayout.widget.CoordinatorLayout>