<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:gravity="center">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="248dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardBackgroundColor="#8A17171A"
        app:cardCornerRadius="26dp"
        app:cardElevation="0dp"
        app:strokeColor="#38FFFFFF"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="26dp"
            android:paddingBottom="24dp">

            <com.walle.wallpaper.ui.widgets.PolygonProgressView
                android:id="@+id/progress_polygon"
                android:layout_width="120dp"
                android:layout_height="120dp" />

            <TextView
                android:id="@+id/zigzag_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:alpha="0.85"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="Wallpaper Applied Successfully…"
                android:textAlignment="center"
                android:textColor="@color/accent"
                android:textSize="13sp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
